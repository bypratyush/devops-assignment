// Grafana Alloy = the log shipper (Promtail's successor).
// It asks the Docker API which containers belong to this compose project,
// tails their stdout/stderr and pushes the lines to Loki with a few labels.

discovery.docker "compose" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=monitoring-demo"]
  }
}

discovery.relabel "compose" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "compose" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.compose.targets
  relabel_rules = discovery.relabel.compose.rules
  forward_to    = [loki.process.app_json.receiver]
}

// The app logs JSON. Promote only `level` to a label (low cardinality);
// status, path, duration stay in the line and are parsed at query time.
loki.process "app_json" {
  stage.match {
    selector = "{service=\"app\"}"
    stage.json {
      expressions = { level = "level" }
    }
    stage.labels {
      values = { level = "" }
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
